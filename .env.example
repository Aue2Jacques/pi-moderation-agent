# 复制为 .env 放在服务器 /workspace/pi-moderation-agent/.env，不进 git。
# 列顺序 = 需要的时间顺序。MVP（阶段 0–3）只需第 1 组；其余按周补。

# ===== 1. 中转站（MVP 必需，阶段 2 起）=====
RELAY_BASE_URL=                      # OpenAI 兼容，形如 https://xxx/v1
RELAY_API_KEY=
AGENT_MODEL=                         # agent 主模型，候选 glm-5.3 / qwen3.8-flash（按 config/models.json 的实测名）
STRONG_MODEL=                        # escalate_model 用的更强模型（主比较时关闭，可先留空）
JUDGE_MODEL=qwen3.8-flash            # logprob 判官：必须返回 top_logprobs（qwen3.8-flash、glm-5.3 实测可以）
SENSITIVE_CHECK_MODEL=glm-5.3-flash  # 替我判定文本样本是否违规（开发者本人不看正文）
VISION_CHECK_MODEL=                  # 替我判定图片样本（中转站除 glm-5.3 外的模型都有视觉，待逐个实测）

# ===== 2. Jev 第三方渠道（W2 判官基准起；MVP 可无）=====
JEV_BASE_URL=
JEV_API_KEY=
JEV_API_KIND=                        # systemone | openai-chat   ← 待确认：渠道是否提供 /v1/systemone（classify 接口）

# ===== 3. Cloudflare Workers AI：Clef-flash 视觉判官（W4 起）=====
CF_ACCOUNT_ID=
CF_API_TOKEN=                        # 权限：Workers AI Read/Run

# ===== 4. 人工授权（自己生成：openssl rand -hex 16）=====
HUMAN_REVIEW_TOKEN=

# ===== 5. Modal：Laya 服务、Qwen3Guard / Llama Guard 4 基线（W5）=====
# 不走 .env，在服务器跑 `modal token new` 生成 ~/.modal.toml；或填下面两项由脚本写入
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ===== 6. Hugging Face：UnsafeBench（签 DUA 后 gated）、VLGuard（W4）=====
HF_TOKEN=

# ===== 7. 云厂商对照（W1 调 1 条验证；W8 正式）=====
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-shanghai

# ===== 8. Kaggle：Laya 微调（W5，可选）=====
# 放 ~/.kaggle/kaggle.json，不走 .env

# ===== 运行参数（有默认值，可不填）=====
APP_DB=data/app.db
SESSION_DB=data/session.sqlite
ADMIT_MAX=10
LEASE_TTL_MS=30000
DEADLINE_MS_SHORT=60000
FLAG_ESCALATION=false
LOG_LEVEL=info
